# Koneksi ke MySQL lokal (XAMPP / Laragon). Salin file ini menjadi .env.local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=latihan_retail

# Backend leaderboard (be-web-learn) + kunci rahasia dari dosen/pemateri (harus sama dengan SERVICE_KEY di backend)
BE_API_URL=http://localhost:3000/api
SERVICE_KEY=isi-sesuai-backend
